---
// 卡片 v2：只放主帖；引用推收成底部一行；配图贴边 16:9 只放第一张
import { fmtDate, richText } from '../lib';
import site from '../site.json';
const { item, hidden = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const isThread = item.thread_count > 1;
const media = item.media || [];
const first = media[0];
const q = item.quoted;
---
<article class="card" data-hidden={hidden ? '' : undefined}>
  <header class="ch">
    <span class="av sm" style={`background-image:url(${base}avatar.png)`} aria-hidden="true"></span>
    <div>
      <div class="nm">{site.name}</div>
      <div class="mt">@{site.handle} · {fmtDate(item.created_at)}</div>
    </div>
    <span class="badge">★ 精选</span>
  </header>
  {first && (
    <a class="media" href={first.type === 'photo' ? `${base}${first.src}` : item.url} target="_blank" rel="noopener">
      <img src={`${base}${first.src}`} alt={first.alt || ''} loading="lazy" />
      {first.type !== 'photo' && <span class="play">▶</span>}
      {media.length > 1 && <span class="more-n">+{media.length - 1}</span>}
    </a>
  )}
  <div class={`txt clamp${first ? '' : ' big'}`} set:html={richText(item.text)} />
  <button class={`expand${first ? '' : ' big'}`} type="button" hidden>展开全文</button>
  <footer class="cf">
    <span class="cfl">
      {isThread && <span>Thread · 共 {item.thread_count} 条</span>}
      {isThread && q && <span class="dot">·</span>}
      {q && <a class="qref" href={q.url} target="_blank" rel="noopener">引用 <b>{q.author_handle ? `@${q.author_handle}` : '一条推文'}</b></a>}
    </span>
    <a href={item.url} target="_blank" rel="noopener">在 X 查看 ↗</a>
  </footer>
</article>
